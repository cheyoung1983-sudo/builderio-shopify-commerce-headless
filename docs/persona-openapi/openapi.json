{
  "openapi": "3.0.3",
  "info": {
    "title": "Persona Public API",
    "version": "2025-10-27",
    "description": "OpenAPI specification for Persona Inquiries, Verifications, and Accounts."
  },
  "paths": {
    "/inquiries": {
      "post": {
        "summary": "Create an Inquiry",
        "operationId": "createInquiry"
      },
      "get": {
        "summary": "List Inquiries",
        "operationId": "listInquiries"
      }
    },
    "/inquiries/{inquiryId}": {
      "get": {
        "summary": "Retrieve an Inquiry",
        "operationId": "retrieveInquiry"
      }
    },
    "/inquiries/{inquiryId}/resume": {
      "post": {
        "summary": "Resume an Inquiry",
        "operationId": "resumeInquiry"
      }
    }
  }
}
