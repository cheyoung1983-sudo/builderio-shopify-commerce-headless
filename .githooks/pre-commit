#!/bin/sh
# Fast pre-commit: hardcoded-secret scan on staged changes, CI/config
# integrity, ESLint on staged files, and a type-check.
# Enabled automatically via `npm install` (the "prepare" script runs
# scripts/setup-git-hooks.cjs, which sets core.hooksPath to .githooks).
# Bypass in an emergency with: git commit --no-verify
exec node scripts/precheck.mjs --staged
