#!/bin/sh
# 1. Branch protection guard: reject direct pushes to main branch
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo ""
  echo "================================================================================"
  echo "⚠️  REMINDER: Direct push to '$current_branch' is forbidden by repository safety rules!"
  echo "================================================================================"
  echo "All changes must go through a feature branch and Pull Request (PR)."
  echo ""
  echo "To safely push your work:"
  echo "  1) Switch to a feature branch:"
  echo "     git checkout -b <branch-name>"
  echo "  2) Push your branch to origin:"
  echo "     git push -u origin <branch-name>"
  echo "  3) Open a Pull Request on GitHub to merge into $current_branch."
  echo ""
  echo "(Emergency bypass: git push --no-verify)"
  echo "================================================================================"
  echo ""
  exit 1
fi

# 2. Full CI-equivalent check before pushing (same steps as .github/workflows/ci.yml).
# Skip the slow production build with: SKIP_BUILD=1 git push
# Bypass in an emergency with: git push --no-verify
exec node scripts/precheck.mjs

