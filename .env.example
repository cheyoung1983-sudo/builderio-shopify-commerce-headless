# Builder.io Public API Key
# Found in: https://builder.io/account/organization
BUILDER_PUBLIC_KEY=
NEXT_PUBLIC_BUILDER_PUBLIC_KEY=

# Shopify Store Domain
# Example: your-store.myshopify.com
# SHOPIFY_DOMAIN is accepted as an alias for SHOPIFY_STORE_DOMAIN.
SHOPIFY_STORE_DOMAIN=displaycellpros.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Shopify Storefront API Token
# Required for fetching products and collections.
# SHOPIFY_STOREFRONT_API_TOKEN is the server-side (private) token; it also
# accepts SHOPIFY_STOREFRONT_ACCESS_TOKEN as an alias.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN is exposed to the browser and must
# be a public Storefront API token, never a private Admin API token.
SHOPIFY_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# Shopify Customer Account API Configuration
# Used for customer authentication and account management
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=102354289012
SHOPIFY_CUSTOMER_ACCOUNT_API_SCOPE=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2025-10

# Site URL
# Used for SEO, absolute links, and OAuth redirect URIs
# Example: https://your-site.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Shopify Admin API (for server-side mutations if needed)
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
