BUILDER_PUBLIC_KEY=
# Builder.io
BUILDER_PUBLIC_KEY=

# Shopify Storefront API
# Keep private tokens in SHOPIFY_STOREFRONT_API_TOKEN on the server.
# Use NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN only for a public Storefront token.
SHOPIFY_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# Shopify app/server credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2025-10
NEXT_PUBLIC_SITE_URL=

# Runtime
NODE_VERSION=24
IS_DEMO=
