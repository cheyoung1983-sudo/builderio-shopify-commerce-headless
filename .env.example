# Builder.io
BUILDER_PUBLIC_KEY=
NEXT_PUBLIC_BUILDER_PUBLIC_KEY=
# Optional published Builder model for the announcement bar; leave blank when unused.
NEXT_PUBLIC_BUILDER_ANNOUNCEMENT_MODEL=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=displaycellpros.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=

# Shopify Admin API (server-only). Uses the client credentials grant for a
# Dev Dashboard app installed on the store (same Shopify organization).
# SHOPIFY_STORE_DOMAIN above must be the *.myshopify.com domain.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: Admin API version (defaults to 2026-01).
SHOPIFY_ADMIN_API_VERSION=
# Optional: webhook signing secret; falls back to SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=
# Optional static Admin token override; leave blank to use client credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=

# Canonical site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin area (/admin, /api/tribal/admin, /api/config, /api/health) — HTTP Basic Auth.
# Admin is blocked (503) until BOTH are set. Use a long random password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
