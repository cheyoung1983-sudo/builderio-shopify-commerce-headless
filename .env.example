# Builder.io
BUILDER_PUBLIC_KEY=
NEXT_PUBLIC_BUILDER_PUBLIC_KEY=
# Optional published Builder model for the announcement bar; leave blank when unused.
NEXT_PUBLIC_BUILDER_ANNOUNCEMENT_MODEL=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=displaycellpros.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=

# Shopify Admin API (server-only). Uses the client credentials grant for a
# Dev Dashboard app installed on the store (same Shopify organization).
# SHOPIFY_STORE_DOMAIN above must be the *.myshopify.com domain.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: Admin API version (defaults to 2026-01).
SHOPIFY_ADMIN_API_VERSION=
# Optional: webhook signing secret; falls back to SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=
# Optional static Admin token override; leave blank to use client credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=

# Canonical site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin area (/admin, /api/tribal/admin, /api/config, /api/health) — HTTP Basic Auth.
# Admin is blocked (503) until BOTH are set. Use a long random password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Auth0 Authentication
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Persona Identity Verification
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=

# Google tag (gtag.js / GA4) measurement ID, e.g. G-XXXXXXXXXX. Public build-time
# variable (inlined into the client bundle; a change needs a redeploy). The tag is
# only loaded when this is set AND matches /^G-[A-Z0-9]+$/. Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Tribal ID verification (manual review + Stripe Identity TEST MODE)
# ---------------------------------------------------------------------------
# Master switch for the review flow. Anything other than 'true' keeps the 501 manual fallback.
TRIBAL_VERIFY_ENABLED=
# Duplicate-ID / duplicate-person detection key (HMAC). REQUIRED in production (fails closed
# with 503 when missing). Use a long random value; never reuse another secret.
TRIBAL_DUPLICATE_HMAC_SECRET=

# Stripe Identity (hosted ID + selfie check). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# Set these in Vercel PRODUCTION ONLY, with TEST-mode keys (sk_test_ / rk_test_). Do not set
# them for Preview or Development: preview URLs change and sit behind Vercel sign-in, so
# Stripe cannot reach them; preview testing is done with the mocked unit tests only.
# Gate: the webhook returns 404 and no session is created unless this is exactly 'true'.
# Session creation additionally requires TRIBAL_VERIFY_ENABLED=true. The webhook does not.
STRIPE_IDENTITY_ENABLED=
# Restricted key (rk_test_...) with ONLY: Identity VerificationSessions write (create + redact).
STRIPE_IDENTITY_RESTRICTED_KEY=
# Signing secret (whsec_...) of the ONE test-mode webhook endpoint:
#   https://www.displaycellpros.com/api/webhooks/stripe-identity
# subscribed to identity.verification_session.{processing,verified,requires_input,canceled}.
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Test-mode guard, ON by default. Only the literal 'false' allows live keys/events. Leave blank.
TRIBAL_STRIPE_TEST_MODE_ONLY=
# Optional: base URL for Stripe's return_url (host must be displaycellpros.com). Defaults to NEXT_PUBLIC_SITE_URL.
TRIBAL_STRIPE_RETURN_BASE_URL=
