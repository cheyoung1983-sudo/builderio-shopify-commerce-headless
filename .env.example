# Builder.io
BUILDER_PUBLIC_KEY=
NEXT_PUBLIC_BUILDER_PUBLIC_KEY=
# Optional published Builder model for the announcement bar; leave blank when unused.
NEXT_PUBLIC_BUILDER_ANNOUNCEMENT_MODEL=

# Shopify Storefront API
SHOPIFY_STORE_DOMAIN=displaycellpros.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=

# Shopify Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=

# Canonical site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin area (/admin, /api/tribal/admin, /api/config, /api/health) — HTTP Basic Auth.
# Admin is blocked (503) until BOTH are set. Use a long random password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ElevenLabs voice-intake tools (/api/pricing/quote, /api/intake/dispatch-sms,
# /api/intake/escalate-tier3). The agent must send this value in the
# X-DCP-Agent-Secret header. All three endpoints return 503 until it is set.
ELEVENLABS_WEBHOOK_SECRET=
# Twilio SMS for /api/intake/dispatch-sms (returns 503 until all three are set).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Slack incoming webhook for /api/intake/escalate-tier3 (returns 503 until set).
SLACK_ESCALATION_WEBHOOK_URL=
