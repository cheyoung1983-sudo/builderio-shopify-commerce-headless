{
  "name": "nextjs-shopify",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "resolutions": {
    "isolated-vm": "6.2.0",
    "minimatch": "9.0.9"
  },
  "overrides": {
    "isolated-vm": "6.2.0",
    "minimatch": "9.0.9",
    "detective-postcss": {
      "postcss": "^8.5.28"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/build.cjs",
    "start": "next start",
    "lint": "eslint blocks components config context lib pages services",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-hardcoded-secrets.cjs",
    "check:customer-account-auth-health": "node scripts/check-customer-account-auth-health.cjs",
    "check:xss-hardening": "node scripts/check-xss-hardening.cjs",
    "check:security-boundaries": "node scripts/check-security-boundaries.cjs",
    "test:security": "node scripts/test-security-boundaries.cjs",
    "verify:rebuild": "node scripts/rebuild-and-verify.cjs",
    "fix:xss-hardening": "node scripts/check-xss-hardening.cjs --fix",
    "check:node-version": "node scripts/check-node-version-consistency.cjs",
    "check:builder-content": "node scripts/check-builder-content-health.cjs",
    "check:project-health": "node scripts/check-project-health.cjs",
    "health": "node scripts/project-health.cjs",
    "health:fix": "node scripts/project-health.cjs --fix",
    "check:ci-integrity": "node scripts/check-ci-integrity.cjs",
    "check:dependency-health": "node scripts/check-dependency-health.cjs",
    "check:dev-health": "node scripts/check-dev-health.cjs",
    "check:stale-branches": "node scripts/check-stale-branches.cjs",
    "check:shopify-catalog-health": "node scripts/check-shopify-catalog-health.cjs",
    "fix:shopify-catalog-health": "node scripts/check-shopify-catalog-health.cjs --fix",
    "diagnose:shopify": "node scripts/diagnose-shopify.cjs",
    "cleanup": "node scripts/cleanup-project.cjs",
    "deploy:dev": "node scripts/deploy.cjs dev",
    "deploy:preview": "node scripts/deploy.cjs preview",
    "deploy:production": "node scripts/deploy.cjs production",
    "check:security-cors": "node scripts/check-security-and-cors-health.cjs",
    "fix:security-cors": "node scripts/check-security-and-cors-health.cjs --fix",
    "precheck": "npm run check:node-version && npm run check:ci-integrity && npm run check:dependency-health && npm run check:security-cors && npm run typecheck && npm run lint && npm run check:secrets && npm run check:customer-account-auth-health && npm run check:xss-hardening",
    "prepare": "node scripts/setup-git-hooks.cjs && node scripts/patch-csp-eval.cjs",
    "analyze": "BUNDLE_ANALYZE=both npm run build",
    "find:unused": "next-unused",
    "prettier": "prettier",
    "lint:a11y": "stylelint \"**/*.css\"",
    "test:a11y": "jest"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "next-unused": {
    "alias": {
      "@lib/*": [
        "lib/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@components/*": [
        "components/*"
      ],
      "@utils/*": [
        "utils/*"
      ]
    },
    "debug": true,
    "include": [
      "components",
      "lib",
      "pages",
      "sections"
    ],
    "exclude": [],
    "entrypoints": [
      "pages"
    ]
  },
  "dependencies": {
    "@builder.io/dev-tools": "^1.85.1",
    "@builder.io/react": "^3.1.1",
    "@builder.io/utils": "1.1.10",
    "@builder.io/widgets": "1.2.24",
    "@elevenlabs/client": "^1.25.0",
    "@emotion/react": "^11.10.6",
    "@google/genai": "^2.23.0",
    "@radix-ui/react-dialog": "^1.0.2",
    "@reach/dialog": "^0.18.0",
    "@reach/portal": "0.14.0",
    "@sentry/node": "^11.0.0",
    "@shopify/storefront-api-client": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@theme-ui/components": "0.15.5",
    "@theme-ui/match-media": "0.15.5",
    "@theme-ui/preset-base": "0.15.5",
    "@theme-ui/presets": "0.15.5",
    "@types/shopify-buy": "2.10.3",
    "@types/traverse": "0.6.32",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vercel/toolbar": "^0.2.7",
    "autoprefixer": "^10.5.5",
    "cheerio": "1.0.0-rc.12",
    "d3-geo": "^3.1.1",
    "elevenlabs": "^1.59.0",
    "framer-motion": "^13.4.0",
    "js-cookie": "3.0.7",
    "lucide-react": "^1.43.0",
    "motion": "^13.4.0",
    "next": "16.3.4",
    "next-seo": "5.15.0",
    "nprogress": "^0.2.0",
    "postcss": "^8.5.28",
    "pure-react-carousel": "^1.30.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-simple-maps": "^5.0.5",
    "react-spring": "^9.6.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "shopify-buy": "^2.16.1",
    "tailwindcss": "^4.3.3",
    "theme-ui": "0.15.5",
    "traverse": "0.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@shopify/ai-toolkit": "^1.8.0",
    "@types/js-cookie": "3.0.3",
    "@types/node": "18.14.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "18.0.28",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "29.4.3",
    "jest-axe": "^7.0.1",
    "jest-environment-jsdom": "^30.5.1",
    "next-unused": "0.0.6",
    "postcss-flexbugs-fixes": "5.0.2",
    "prettier": "2.8.4",
    "stylelint": "^15.11.0",
    "stylelint-a11y": "^1.2.3",
    "stylelint-config-standard": "^30.0.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "allowScripts": {
    "preact": true,
    "isolated-vm": true,
    "unrs-resolver": true
  }
}
