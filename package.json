{
  "name": "nextjs-shopify",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "resolutions": {
    "isolated-vm": "7.0.1",
    "minimatch": "9.0.9"
  },
  "overrides": {
    "isolated-vm": "7.0.1",
    "minimatch": "9.0.9",
    "detective-postcss": {
      "postcss": "^8.5.28"
    }
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "npm run precheck && next build",
    "start": "next start",
    "lint": "eslint blocks components config context lib pages services",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-hardcoded-secrets.js",
    "check:node-version": "node scripts/check-node-version-consistency.js",
    "check:project-health": "node scripts/check-project-health.js",
    "check:ci-integrity": "node scripts/check-ci-integrity.js",
    "check:stale-branches": "node scripts/check-stale-branches.js",
    "deploy:dev": "node scripts/deploy.js dev",
    "deploy:preview": "node scripts/deploy.js preview",
    "deploy:production": "node scripts/deploy.js production",
    "precheck": "npm run check:node-version && npm run check:ci-integrity && npm run typecheck && npm run lint && npm run check:secrets",
    "prepare": "node scripts/setup-git-hooks.js",
    "analyze": "BUNDLE_ANALYZE=both npm run build",
    "find:unused": "next-unused",
    "prettier": "prettier",
    "lint:a11y": "stylelint \"**/*.css\"",
    "test:a11y": "jest"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "next-unused": {
    "alias": {
      "@lib/*": [
        "lib/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@components/*": [
        "components/*"
      ],
      "@utils/*": [
        "utils/*"
      ]
    },
    "debug": true,
    "include": [
      "components",
      "lib",
      "pages",
      "sections"
    ],
    "exclude": [],
    "entrypoints": [
      "pages"
    ]
  },
  "dependencies": {
    "@builder.io/react": "^3.1.1",
    "@builder.io/utils": "1.1.10",
    "@builder.io/widgets": "1.2.24",
    "@emotion/react": "^11.10.6",
    "@radix-ui/react-dialog": "^1.0.2",
    "@reach/dialog": "^0.18.0",
    "@reach/portal": "0.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@theme-ui/components": "0.15.5",
    "@theme-ui/match-media": "0.15.5",
    "@theme-ui/preset-base": "0.15.5",
    "@theme-ui/presets": "0.15.5",
    "@types/shopify-buy": "2.10.3",
    "@types/traverse": "0.6.32",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.5.5",
    "cheerio": "1.0.0-rc.12",
    "js-cookie": "3.0.7",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-seo": "5.15.0",
    "postcss": "^8.5.28",
    "pure-react-carousel": "^1.30.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-spring": "^9.6.1",
    "shopify-buy": "^2.16.1",
    "tailwindcss": "^4.3.3",
    "theme-ui": "0.15.5",
    "traverse": "0.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@shopify/ai-toolkit": "^1.8.0",
    "@types/js-cookie": "3.0.3",
    "@types/node": "18.14.0",
    "@types/react": "18.0.28",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "29.4.3",
    "jest-axe": "^7.0.1",
    "jest-environment-jsdom": "^30.5.1",
    "next-unused": "0.0.6",
    "postcss-flexbugs-fixes": "5.0.2",
    "prettier": "2.8.4",
    "stylelint": "^15.11.0",
    "stylelint-a11y": "^1.2.3",
    "stylelint-config-standard": "^30.0.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
